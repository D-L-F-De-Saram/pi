PI_PROVIDER=google
PI_MODEL=gemini-3.7-flash
PI_THINKING=low
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
JUNIOR_DE_SARAM_API_KEY=
JUNIOR_DE_SARAM_MODEL_NAME=junior-de-saram-pi
DESARAM_RESEARCH_URL=http://127.0.0.1:18124
DESARAM_RESEARCH_KEY=
DESARAM_DRAFTER_URL=http://127.0.0.1:19125
DESARAM_DRAFTER_KEY=
# Private metadata catalog; no firm sample bodies are stored in this wiki.
# Compose mounts this ignored host directory read/write; set an absolute server path on deployment.
JUNIOR_DE_SARAM_WIKI_HOST_PATH=./junior-de-saram/private-wiki
# Native CLI defaults; Docker overrides these paths inside the host-mounted catalog.
JUNIOR_DE_SARAM_KB_ROOT=./junior-de-saram/private-wiki
JUNIOR_DE_SARAM_CATALOG_ROOT=./junior-de-saram/private-wiki
SERPER_API_KEY=
EXA_API_KEY=
JUNIOR_DE_SARAM_ATTACHMENT_ORIGINS=http://api:3080,http://librechat:3080
JUNIOR_DE_SARAM_MAX_BODY_BYTES=62914560
JUNIOR_DE_SARAM_MAX_FILE_BYTES=52428800

# Read-only De Saram indexed source access; use accessible server URLs or SSH forwards.
DESARAM_TYPESENSE_URL=http://127.0.0.1:18108
DESARAM_TYPESENSE_SEARCH_KEY=
DESARAM_FILE_SERVER_URL=http://127.0.0.1:17008
# Authenticated, read-only original-DOCX gateway in the upload-process service.
# The same long secret is set as DRAFTING_SOURCE_TOKEN in the source service.
DESARAM_DRAFTING_SOURCE_URL=http://127.0.0.1:18130
DESARAM_DRAFTING_SOURCE_TOKEN=
DESARAM_DOCUMENT_VIEWER_URL=https://devdocs.desaram.ai/document.html
CODE_RUNNER_ENABLED=true
JUNIOR_DE_SARAM_PUBLIC_URL=http://127.0.0.1:8160
JUNIOR_DE_SARAM_ARTIFACT_SECRET=
